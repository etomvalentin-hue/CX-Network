! L2 PortChannel vers Distribution VSX
{% for lag in lags_Uplink %}
interface {{ lags.id }}
   description "{{ lag.description }}"
   no shutdown
   no routing
   vlan trunk allowed {{ lag.vlans.allowed }}
   vlan trunk native {{ lag.vlans.native | default(1) }}

! Member Interfaces
{% for member in lag.members %}
interface {{ member.interface }}
   description "{{ member.description }}"
   no shutdown
   no routing
   port-channel {{ lag.id }} mode {{ lag.mode }}

! Désactiver le spanning-tree sur les membres (géré sur le PortChannel)
spanning-tree {{ member.interface }} admin-point-to-point
{% endfor %}

! LACP Configuration
{% if lag.protocol == "lacp" %}
interface {{ lag.id }}
   lacp mode active
{% endif %}

! Spanning-tree sur le PortChannel
spanning-tree {{ lag.id }} admin-edge-port
spanning-tree {{ lag.id }} bpdu-guard
{% endfor %}