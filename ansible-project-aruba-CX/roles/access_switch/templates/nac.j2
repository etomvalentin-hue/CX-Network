! ===== CONFIGURATION NAC - ÉTAPE 1: SERVEUR GROUP =====

{% if nac is defined and nac.enabled | default(false) %}
! Création du groupe de serveurs RADIUS
aaa group server radius "{{ nac.server_groups[0].name }}"
   server {{ nac.server_groups[0].servers[0].host }}
   server {{ nac.server_groups[0].servers[1].host }}
   exit
{% else %}
! NAC non configuré
{% endif %}