! ===== CONFIGURATION NAC / 802.1X =====
! Généré automatiquement par Ansible

{% if nac.enabled %}

! Activation globale 802.1X et MAC Authentication
aaa authentication port-access dot1x authenticator enable
aaa authentication port-access mac-auth enable

! Configuration des méthodes d'authentification
aaa authentication port-access dot1x authenticator auth-method  eap-radius
aaa authentication port-access dot1x authenticator radius

aaa authentication port-access mac-auth auth-method pap

! Configuration des groupes RADIUS                                         
aaa authentication port-access dot1x authenticator radius server-group "{{ radius.groups[0].name }}"
aaa authentication port-access mac-auth radius server-group "{{ radius.groups[0].name }}"

! Configuration du reauthentication et timeout
{% for profile in nac.authentication_profiles %}
{% if profile.protocol == "dot1x" and profile.reauthentication %}
aaa authentication port-access dot1x authenticator reauthentication enable
aaa authentication port-access dot1x authenticator quiet-period 0
aaa authentication port-access dot1x authenticator tx-period {{ profile.timeout }}
{% endif %}
{% endfor %}




! VLANs spéciaux NAC
vlan {{ nac.auth_fail_vlan }}
   name "AUTH_FAIL_VLAN"
!
vlan {{ nac.guest_vlan }}
   name "GUEST_VLAN"
!

! Rôles d'autorisation
role name "{{ nac.default_role }}"
!
role name "{{ nac.guest_role }}"
!
role name "{{ nac.voice_role }}"
!



! Logging pour troubleshooting
logging level aaa 6
logging level dot1x 6

! Message de succès
! Configuration NAC appliquée avec succès

{% else %}
! NAC désactivé - Aucune configuration appliquée
{% endif %}

